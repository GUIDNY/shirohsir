MUSIC_PROVIDER_NAME="elevenlabs"
ELEVENLABS_API_KEY=""
# Optional aliases the server also accepts:
# ELEVEN_API_KEY=""
# EVEANLABS_API_KEY=""
# API_KEY=""
# XI_API_KEY=""
ELEVENLABS_MUSIC_API_URL="https://api.elevenlabs.io/v1/music/stream?output_format=mp3_44100_128"
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"
ELEVENLABS_MUSIC_LENGTH_MS="20000"
ELEVENLABS_MUSIC_MODEL_ID="music_v2"
# Real AI-written Hebrew lyrics (lib/song-generation.ts: getHebrewLyrics).
# Falls back to the deterministic template automatically when unset or
# on any API error. From https://aistudio.google.com/apikey — needs a
# key that actually starts with "AIzaSy" (a Cloud project API key, not
# an ephemeral/session token) and has generate_content quota.
GEMINI_API_KEY=""
# GEMINI_MODEL_ID="gemini-2.5-flash"
# Real checkout + webhook-driven crediting (see lib/lemonsqueezy-catalog.ts,
# app/api/webhooks/lemonsqueezy/route.ts). From your Lemon Squeezy dashboard
# → Settings → API (key) and Settings → Webhooks (secret, set when you
# create the webhook pointing at /api/webhooks/lemonsqueezy).
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""

# Accounts, subscriptions & credits (Supabase — new project, separate from my-ski)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Server-only — needed to verify a user's JWT locally without a round trip
# to Supabase's API. From Supabase Dashboard → Project Settings → API →
# JWT Settings. Never expose this to the client (no NEXT_PUBLIC_ prefix).
SUPABASE_JWT_SECRET=""
# The one account with unlimited credits + visibility into the real
# ElevenLabs quota (everyone else uses the site's credit system).
ADMIN_EMAIL=""
# Only needed locally in .env.local to run scripts/migrate.mjs — get this
# from Supabase Dashboard → Project Settings → Database → Connection string
# (use the transaction pooler host, not db.<ref>.supabase.co directly).
# SUPABASE_DB_URL=""
